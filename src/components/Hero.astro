---
/* src/components/Hero.astro */
import portadaData from '../data/portada.json';

const title = portadaData?.title || "Bienvenidos";
const description = portadaData?.description || "";
const botones = portadaData?.botones || [];
const heroImage = portadaData?.image || null;
---

<section class="hero-wrapper">
  
  <div class="hero-image-half">
    <div class="hero-portrait">
      {heroImage ? (
        <img src={heroImage} alt={title} class="hero-img" />
      ) : (
        <div class="hero-placeholder"></div>
      )}
    </div>
  </div>

  <div class="hero-content-half fondo-acento">
    <h1 class="hero-title">{title}</h1>
    
    {description && (
      <p class="hero-desc">{description}</p>
    )}
    
    {botones && botones.length > 0 && (
      <div class="hero-buttons">
        {botones.map((btn: any) => (
          <a href={btn.url} class="btn-principal">
            <span>{btn.texto}</span>
          </a>
        ))}
      </div>
    )}
  </div>

</section>

<style>
  /* Se redujo de 100vh a 80vh para que el módulo no quede excesivamente largo */
  .hero-wrapper {
    width: 100%;
    min-height: 80vh; 
    display: grid;
    grid-template-columns: 1fr 1fr; /* 50% - 50% */
    margin-top: -6rem; /* Absorbe el espacio del header flotante */
    background-color: var(--default-color-similar); /* Fondo base para la mitad de la foto */
  }

  /* --- MITAD DE LA IMAGEN --- */
  .hero-image-half {
    display: flex;
    align-items: flex-end; /* ANCLADO ABAJO: Justifica el retrato a la base */
    justify-content: center;
    padding: 8rem 2rem 0 2rem; /* padding-bottom 0 para que asiente al ras */
  }

  /* El nuevo contenedor de retrato 4:5 */
  .hero-portrait {
    width: 100%;
    max-width: 680px; /* Límite de ancho para que no se estire de más en monitores grandes */
    aspect-ratio: 4 / 5; /* Proporción fotográfica vertical exacta */
    position: relative;
    overflow: hidden;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.165, 0.84, 0.44, 1);
  }
  
  /* Efecto Zoom in al hacer hover en todo el módulo */
  .hero-wrapper:hover .hero-img {
    transform: scale(1.05);
  }

  .hero-placeholder {
    width: 100%;
    height: 100%;
    background-color: #e0e0e0;
  }

  /* --- MITAD DEL CONTENIDO --- */
  .hero-content-half {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 10rem 12% 6rem 12%;
  }
  .hero-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    margin-bottom: 1.5rem;
    line-height: 1.1;
    text-wrap: balance;
  }
  .hero-desc {
    font-size: 1.15rem;
    opacity: 0.9;
    margin-bottom: 3rem;
    max-width: 550px;
  }
  .hero-buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* --- RESPONSIVE MOBILE --- */
  @media (max-width: 900px) {
    .hero-wrapper {
      grid-template-columns: 1fr;
      display: flex;
      flex-direction: column;
    }
    
    .hero-image-half {
      padding: 8rem 1.5rem 2rem 1.5rem; /* En móvil sí lleva padding bottom para separar */
      align-items: center; /* En móvil vuelve a centrarse verticalmente */
    }
    
    .hero-portrait {
      max-width: 420px; /* Reducimos el retrato en celular para que no ocupe toda la pantalla */
      border-radius: var(--radius-card, 24px); /* Lo convertimos en una tarjeta/retrato con bordes curvos */
      box-shadow: 0 15px 35px rgba(0,0,0,0.1); /* Sombra suave para darle profundidad */
    }

    .hero-content-half {
      padding: 3rem 1.5rem 5rem 1.5rem;
      align-items: center;
      text-align: center;
    }
    
    .hero-buttons {
      justify-content: center;
    }
  }
</style>