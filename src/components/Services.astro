---
/* src/components/Services.astro */
const whatsappNumber = "529711503508"; 

// Mensajes específicos por modalidad
const msgPresencial = "Hola Gaby, me gustaría agendar una cita presencial en Coyoacán.";
const msgOnline = "Hola Gaby, me gustaría agendar una cita por videollamada.";

const waPresencial = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(msgPresencial)}`;
const waOnline = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(msgOnline)}`;

const services = [
  {
    title: "Psicología Clínica",
    description: "Espacio seguro para explorar tu historia, gestionar emociones y transformar patrones limitantes.",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>`
  },
  {
    title: "Mediumnidad",
    description: "Conexión intuitiva con seres queridos trascendidos para encontrar respuestas, consuelo y paz.",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"></path></svg>`
  },
  {
    title: "ThetaHealing®",
    description: "Sanación energética profunda para liberar bloqueos desde la raíz y alinear tu bienestar integral.",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path><path d="M2 12h20"></path></svg>`
  }
];
---

<section class="services-module fondo-default">
  <div class="services-container">

    <div class="services-grid">
      {services.map((service, index) => (
        <div class="service-card fondo-acento" style={`--animation-order: ${index};`}>
          <div class="service-icon-wrapper">
            <div class="service-icon" set:html={service.icon} />
          </div>
          <h3 class="service-title">{service.title}</h3>
          <p class="service-desc">{service.description}</p>
        </div>
      ))}
    </div>

    <div class="modalities-wrapper">
      <div class="modalities-content">
        <p class="modalities-label">Inicia tu viaje hoy en la modalidad que mejor se adapte a ti:</p>
        
        <div class="modalities-buttons">
          <a href={waPresencial} target="_blank" rel="noopener noreferrer" class="btn-outline modality-btn" style="border-color: var(--default-color-similar); color: var(--default-color-similar);">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span>Presencial en Coyoacán, CDMX</span>
          </a>
          
          <a href={waOnline} target="_blank" rel="noopener noreferrer" class="btn-outline modality-btn" style="border-color: var(--default-color-similar); color: var(--default-color-similar);">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="23 7 16 12 23 17 23 7"></polygon><rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
            </svg>
            <span>Vía Videollamada</span>
          </a>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .services-module {
    padding: 4rem 1.5rem; /* Más compacto verticalmente */
    position: relative;
  }

  .services-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2.5rem; /* Menor espacio entre cabecera, grid y botones finales */
  }

  /* --- Header --- */
  .services-header {
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1rem; /* Más agrupado */
  }

  .section-title {
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    line-height: 1.1;
  }

  .section-subtitle {
    font-size: 1.15rem;
    opacity: 0.9;
    line-height: 1.5;
    text-wrap: balance;
  }

  /* --- Grid & Cards --- */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem; /* Grid más compacto */
  }

  .service-card {
    border-radius: var(--radius-card, 24px);
    padding: 2.5rem 2rem; /* Reducido para compactar */
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.06);
    transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.4s ease;
    
    animation: fadeUp 0.8s ease backwards;
    animation-delay: calc(var(--animation-order) * 0.15s);
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(40px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .service-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.12);
  }

  /* --- Icon Styling --- */
  .service-icon-wrapper {
    width: 70px; /* Ícono ligeramente más pequeño para compensar la tarjeta compacta */
    height: 70px;
    border-radius: 50%;
    background: rgba(187, 142, 0, 0.1); 
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.2rem; /* Menor separación hacia el título */
    color: var(--color-acento2); 
    transition: transform 0.5s ease, background 0.5s ease;
  }

  .service-card:hover .service-icon-wrapper {
    transform: scale(1.1) rotate(5deg);
    background: rgba(187, 142, 0, 0.15); 
  }

  .service-icon {
    width: 32px;
    height: 32px;
  }

  .service-icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  /* --- Card Content --- */
  .service-title {
    font-size: 2rem; /* Titular agrandado como solicitaste */
    margin-bottom: 0.8rem;
    line-height: 1.1;
  }

  .service-desc {
    font-size: 1.05rem;
    line-height: 1.5;
    opacity: 0.85;
  }

  /* --- Modalidades (Botones Discretos) --- */
  .modalities-wrapper {
    display: flex;
    justify-content: center;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    padding-top: 2.5rem; /* Más compacto hacia arriba */
  }

  .modalities-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    text-align: center;
  }

  .modalities-label {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    opacity: 0.9;
    font-weight: 600;
  }

  .modalities-buttons {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .modality-btn {
    padding: 0.9rem 1.8rem;
    font-size: 0.9rem;
  }

  .modality-btn svg {
    width: 20px;
    height: 20px;
  }

  /* --- Responsive --- */
  @media (max-width: 900px) {
    .services-module {
      padding: 4rem 1.5rem;
    }
    
    .services-grid {
      gap: 1.5rem;
    }
    
    .service-card {
      padding: 2rem 1.5rem;
    }

    .modalities-buttons {
      flex-direction: column;
      width: 100%;
      gap: 1rem;
    }

    .modality-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>