---
/* src/components/Footer.astro */
import settings from '../data/settings.json';

const { title, address, email, telefonos = [] } = settings;
const currentYear = new Date().getFullYear();

---

<footer class="fondo-default" style="padding: 4rem 2rem 2.5rem; display: flex; flex-direction: column; align-items: center; gap: 2rem; width: 100%;">

  <div style="font-size: 1rem; font-weight: 500; letter-spacing: 0.02em;">
    &copy; {currentYear} {title}. Ced. 15282371
  </div>

</footer>