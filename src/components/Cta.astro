---
/* src/components/Cta.astro */
import destacadoData from '../data/destacado.json';

// Leemos el nuevo archivo JSON
const title = destacadoData?.title || "Destacado";
const description = destacadoData?.description || "";
const botones = destacadoData?.botones || [];
const image = destacadoData?.image || null;
---

<section class="cta-module fondo-acento">
  <div class="cta-image-half">
    {image ? (
      <img src={image} alt={title} class="cta-img" />
    ) : (
      <div class="cta-placeholder"></div>
    )}
  </div>

  <div class="cta-content-half">
    <h2 class="cta-title">{title}</h2>
    
    {description && (
      <p class="cta-desc">{description}</p>
    )}
    
    {botones && botones.length > 0 && (
      <div class="cta-buttons">
        {botones.map((btn: any) => (
          <a href={btn.url} class="btn-principal">
            <span>{btn.texto}</span>
          </a>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .cta-module {
    display: grid;
    grid-template-columns: 1fr 1fr; /* 50% - 50% */
    border-radius: var(--radius-card, 24px);
    overflow: hidden;
    box-shadow: 0 15px 40px rgba(0,0,0,0.06);
    width: 100%;
    min-height: 60vh;
  }

  /* --- MITAD DE LA IMAGEN --- */
  .cta-image-half {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .cta-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.165, 0.84, 0.44, 1);
  }
  
  /* Efecto Zoom in en la foto al hacer hover en TODO el módulo */
  .cta-module:hover .cta-img {
    transform: scale(1.05);
  }
  
  .cta-placeholder {
    width: 100%;
    height: 100%;
    opacity: 0.2; /* Tono suave cuando no hay foto */
    background-color: var(--texto-default-color);
  }

  /* --- MITAD DEL CONTENIDO --- */
  .cta-content-half {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 4rem 4.5rem;
  }
  .cta-title {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 1rem;
    line-height: 1.1;
    text-wrap: balance;
  }
  .cta-desc {
    font-size: 1.1rem;
    opacity: 0.9;
    margin-bottom: 2.5rem;
    max-width: 500px;
  }
  .cta-buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* --- RESPONSIVE: MÓVIL --- */
  @media (max-width: 900px) {
    .cta-module {
      grid-template-columns: 1fr;
      min-height: auto;
    }
    
    .cta-image-half {
      height: auto;
      padding: 3.5rem 1.5rem 0 1.5rem; /* Espaciado para que la foto flote dentro del bloque */
      overflow: visible; /* Evitamos que el hover ampute la sombra en móvil */
    }
    
    .cta-img {
      height: auto; /* Al ser auto, no se recorta NADA, respeta su proporción original */
      max-width: 320px; /* Límite de ancho para que se vea como retrato */
      border-radius: 16px; /* Bordes redondeados del retrato */
      box-shadow: 0 15px 35px rgba(0,0,0,0.15); /* Sombra elegante */
      object-fit: contain;
    }

    .cta-content-half {
      padding: 2.5rem 1.5rem 3.5rem 1.5rem;
      text-align: center;
      align-items: center;
    }
    
    .cta-buttons {
      justify-content: center;
    }
  }
</style>